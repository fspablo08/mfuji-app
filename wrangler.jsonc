{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mfuji-app",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Endereço próprio: sistema.mfuji.com.br (Custom Domain; a Cloudflare cria o DNS e o certificado).
  // O domínio mfuji.com.br precisa estar ativo nesta conta da Cloudflare, senão o deploy falha.
  "routes": [{ "pattern": "sistema.mfuji.com.br", "custom_domain": true }],
  // mantém também o endereço antigo (mfuji-app.pablovsfernandes.workers.dev); com routes o padrão seria desligar
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // o Worker atende todas as requisições primeiro: nada é entregue sem login
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mfuji-db",
      "database_id": "5b7f760b-07f6-440b-8cec-79009bbe2aef",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "BACKUPS", "id": "daef3f45b5e643bca2bff1627caa1958" }
  ],
  // Google Drive: pasta "Monte Fuji Dedetizadora e Desentupidora", modelo da OS (05 - Modelos) e a conta que autoriza.
  // GOOGLE_CLIENT_ID e GOOGLE_CLIENT_SECRET são segredos: ficam só no painel da Cloudflare (Settings › Variables and Secrets).
  "vars": {
    "DRIVE_RAIZ": "1Xb20d77x_1GdydM1Gm526Lk4zSquMLKS",
    "OS_MODELO": "1844GEpPlzp5QYl76sOZ3YYbu-fT0t4JMuwGRgSJFzGU",
    "GOOGLE_CONTA": "atendimento@mfuji.com.br"
  },
  // backup diário dos dados às 6h UTC (3h em Brasília)
  "triggers": { "crons": ["0 6 * * *"] },
  "observability": { "enabled": true }
}
